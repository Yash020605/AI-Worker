# ============================================================
# Autonomous AI Worker — Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# --- LLM Provider (choose one) ---
OPENAI_API_KEY=sk-your-openai-key-here
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# --- Default model to use ---
LLM_MODEL=gpt-4o
# LLM_MODEL=gpt-3.5-turbo
# LLM_MODEL=claude-3-5-sonnet-20241022

# --- Agent Settings ---
AGENT_MAX_ITERATIONS=15
AGENT_TIMEOUT_SECONDS=120
AGENT_TEMPERATURE=0.1

# --- App Server ---
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# --- Simulated Company App ---
MOCK_APP_HOST=0.0.0.0
MOCK_APP_PORT=8001

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./data/agent.db

# --- Memory ---
MEMORY_MAX_TOKENS=4000
MEMORY_WINDOW_SIZE=10

# --- Browser Automation ---
BROWSER_HEADLESS=true
BROWSER_TIMEOUT=30000

# --- Human Approval ---
# Comma-separated list of action types that ALWAYS require human approval
REQUIRE_APPROVAL_FOR=delete,payment,send_email,external_post

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/agent.log
